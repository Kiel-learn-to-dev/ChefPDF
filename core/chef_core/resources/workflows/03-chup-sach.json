{
  "id": "chup-sach",
  "name": "Chụp sách",
  "description": "Dò viền và cắt trang, nắn thẳng chữ, làm trắng nền, nén và ghép thành PDF. Dùng cho ảnh chụp sách bằng điện thoại.",
  "version": 1,
  "steps": [
    {
      "op": "pageimg.autoCrop",
      "label": "Dò viền và cắt trang"
    },
    {
      "op": "pageimg.deskew",
      "label": "Nắn thẳng chữ"
    },
    {
      "op": "pageimg.enhance",
      "label": "Làm trắng nền",
      "params": {"whiten": true}
    },
    {
      "op": "compress.pdf",
      "label": "Nén",
      "params": {"preset": "ebook"}
    }
  ],
  "inputs": {"accept": ["pdf"], "password": false},
  "output": {"mode": "suffix", "suffix": "_sach"},
  "variables": {}
}
