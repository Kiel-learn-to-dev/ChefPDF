{
  "id": "phat-hanh-van-ban",
  "name": "Phát hành văn bản",
  "description": "Đánh số trang theo NĐ 30, đóng dấu giáp lai rồi ký số để chữ ký bao phủ bản PDF cuối. Cần ảnh dấu giáp lai (PNG/JPEG), file chứng thư số và mật khẩu.",
  "version": 1,
  "steps": [
    {
      "op": "overlay.pageNumbers",
      "label": "Đánh số trang (NĐ 30)",
      "params": {"preset": "nd30"}
    },
    {
      "op": "stamp.seam",
      "label": "Dấu giáp lai",
      "params": {"path": "{{seamPath}}", "side": "right", "vertical": "top"}
    },
    {
      "op": "sign.pades",
      "label": "Ký số",
      "params": {"pfxPath": "{{pfxPath}}", "password": "{{secret:password}}"}
    }
  ],
  "inputs": {"accept": ["pdf"], "password": false},
  "output": {"mode": "suffix", "suffix": "_phat-hanh"},
  "variables": {"seamPath": "", "pfxPath": ""}
}
