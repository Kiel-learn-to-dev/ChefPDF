{
  "name": "chef-pdf",
  "private": true,
  "version": "1.2.0",
  "description": "Chef PDF - desktop PDF app (personal use)",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @chef/desktop dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "pnpm -r test",
    "e2e": "pnpm --filter @chef/e2e e2e",
    "build:core": "node packaging/build-core.mjs",
    "package": "node packaging/package.mjs",
    "codegen": "pnpm --filter @chef/contracts codegen"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
  },
  "type": "module"
}
