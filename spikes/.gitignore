# Spike outputs are regenerated by s1/run_all.sh and s2/run_all.sh.
# Keep only small evidence files: JSON results, PNG renders, a few signed samples.
.venv/
token_probe_report.json

# the repo root ignores every out/ directory; re-include these two first
!s1/out/
s1/out/*
!s1/out/*.json
!s1/out/*.png
!s1/out/a_bb_invisible.pdf
!s1/out/b2_visible_custom_appearance.pdf
!s1/out/d_blta.pdf
!s1/out/e2_second_signature.pdf
!s1/out/f2_certified_plus_approval.pdf
# test root CA, so the signed samples can be checked in Adobe Reader / Foxit
!s1/out/pki/
s1/out/pki/*
!s1/out/pki/root.crt.pem

!s2/out/
s2/out/*
!s2/out/*.json
!s2/out/*.png
